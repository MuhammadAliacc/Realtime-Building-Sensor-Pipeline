# Copy to .env to override the defaults baked into docker-compose.yml.
# Not required to run `docker compose up` as-is.

# --- messaging ---
KAFKA_BROKER=kafka:9092
SENSOR_TOPIC=building-sensor-readings
ALERT_TOPIC=sensor-alerts

# --- load generator ---
NUM_BUILDINGS=3
SENSORS_PER_BUILDING=2
EMIT_INTERVAL_SECONDS=1.0
ANOMALY_PROBABILITY=0.02

# --- stream processor ---
BATCH_SIZE=50
BATCH_FLUSH_SECONDS=5
ANOMALY_WINDOW=30
ANOMALY_THRESHOLD=3.0
ANOMALY_MIN_SAMPLES=10

# --- storage ---
DATABASE_URL=postgresql://pipeline:pipeline@postgres:5432/sensor_pipeline
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sensor-archive
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- observability ---
LOG_LEVEL=INFO
